<?mso-application progid="Excel.Sheet"?>
<html>
<head>
<title>Timestatistikk</title>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
<style type="text/css">

table {
	width: 100%;
}

td {
	vertical-align: top;
	border: 0.1pt solid #C2C2C2;
}

th {
	font-weight: normal;
	text-align: left;
	vertical-align: middle;
	border: 0.1pt solid #C2C2C2;
	background-color: #E7E8E7;
}

/* This seems unnecessary, but without it the background color won't show! */
table.contentTable th {
	font-weight: normal;
	text-align: left;
	vertical-align: middle;
	border: 0.1pt solid #C2C2C2;
	background-color: #E7E8E7;
}

.right {
	text-align: right;
}

.center {
	text-align: center;
}

.middle {
	vertical-align: middle;
}

.nowrap, .nowrapScreen {
	white-space: nowrap;
}

p {
	margin: 0;
	padding: 0;
}

h1 {
	font-size: 140%;
	font-weight: bold;
	mso-number-format:\@;
}

h2 {
	font-size: 120%;
	font-weight: bold;
	mso-number-format:\@;
}

h3 {
	font-size: 110%;
	font-weight: bold;
	mso-number-format:\@;
}

h4 {
	font-size: 103%;
	font-style: italics;
	font-weight: normal;
	mso-number-format:\@;
}

</style>

</head>
